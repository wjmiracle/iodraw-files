        <mxCell id="merged-01-v47" value="装备 / 属性 / 矿物 / 战斗 / 怪物 / Boss。&#xa;任务 / 商店 / NPC / 制作 / 补给 / 原版生活。&#xa;独立界面 / 死亡重试 / 存档 / 图鉴 / 合作。&#xa;区域与终局内容、素材工坊与验收计划。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.2;fontColor=#263549;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;align=left;verticalAlign=middle;spacing=18;shadow=0;" parent="1" vertex="1" mergeSourceCellIds="xuanji-main-v11,xuanji-services-v44">
