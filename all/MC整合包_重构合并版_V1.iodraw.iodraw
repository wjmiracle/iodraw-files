        <mxCell id="merged-04-v43" value="统计 Boss 击杀数量 + 成功数字改写次数。&#xa;击杀是否去重、重试是否计数、跨存档范围待定。&#xa;个人阶段或全服共享、合作同步与阈值待定。&#xa;确认成功的改写才计数；取消和预览不计成长。" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.2;fontColor=#263549;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;align=left;verticalAlign=middle;spacing=18;shadow=0;" mergeSourceCellIds="xuanji-services-v42">
