        <mxCell id="merged-06-v48" value="保留现有两地区剧情，改为探索与阶段相关任务。&#xa;保留调查点 / 遗迹线索 / 发现奖励与特殊探访。&#xa;短教学：营地 / 改写 / 自由技能 / 制作 / 回程。&#xa;Boss 战果与区域开放衔接阶段，不强制职业入职。" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.2;fontColor=#263549;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;align=left;verticalAlign=middle;spacing=18;shadow=0;" mergeSourceCellIds="xuanji-main-v32,xuanji-services-v24,xuanji-digit-v38">
