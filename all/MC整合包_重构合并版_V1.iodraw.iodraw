        <mxCell id="merged-02-v23" value="拖起数字 1 → 吸附数位 → 预览 → 确认扣资源。&#xa;原图合法插入：20 → 120 / 210 / 201。&#xa;小数示例：1.6 → 11.6 / 1.16 / 1.61。&#xa;单位留原位；落空、取消或无法存储不扣机会。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.2;fontColor=#263549;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;align=left;verticalAlign=middle;spacing=18;shadow=0;" parent="1" vertex="1" mergeSourceCellIds="xuanji-digit-v8,xuanji-digit-v9,xuanji-digit-v10,xuanji-digit-v11,xuanji-digit-v12,xuanji-digit-v49">
