        <mxCell id="merged-02-v38" value="取消解锁道具恢复机会、单道具重复改写。&#xa;取消解锁配方和旧版自动补偿为再次改写机会。&#xa;旧锁、已解锁状态与道具需要制定迁移策略。&#xa;旧进度保留为历史；迁移方案不能破坏永久锁。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.2;fontColor=#263549;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;align=left;verticalAlign=middle;spacing=18;shadow=0;" parent="1" vertex="1" mergeSourceCellIds="xuanji-digit-v47,xuanji-digit-v49,xuanji-delivery-v35">
