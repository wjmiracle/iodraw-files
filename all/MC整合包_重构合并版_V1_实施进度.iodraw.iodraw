        <mxCell id="merged-06-v38" value="保留货币：任务 / 讨伐收入，补给 / 工艺支出。&#xa;原型已有钱包、库存、报价与回收服务。&#xa;钱包与固定报价组的改写采用永久锁定。&#xa;服务端保存余额与报价；补货不刷新改写机会。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.2;fontColor=#263549;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;align=left;verticalAlign=middle;spacing=18;shadow=0;" parent="1" vertex="1" mergeSourceCellIds="xuanji-services-v27,xuanji-digit-v44">
